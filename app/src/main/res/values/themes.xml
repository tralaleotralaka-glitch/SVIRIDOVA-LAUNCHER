<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Nexus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_void</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/nexus_cyan</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Диалог длинного нажатия на иконку, в стиле HUD. -->
    <style name="Theme_Nexus_Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/nexus_cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:backgroundDimAmount">0.82</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

</resources>
